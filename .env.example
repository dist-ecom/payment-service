# General Configuration
NODE_ENV=development
PORT=3003
SERVICE_NAME=payment-service
SERVICE_DESCRIPTION=Payment Processing Service

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_service?schema=public

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_PAYMENT_SERVICE_KEY=payment_service_specific_jwt_key
JWT_EXPIRATION=1d

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Service URLs
USER_SERVICE_URL=http://localhost:3000
PRODUCT_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
SERVICE_REGISTRY_URL=http://localhost:8500

# Service Token for inter-service communication
SERVICE_TOKEN=your_service_token_for_interservice_communication

# Mock Payment Gateway (for local development)
ENABLE_MOCK_PAYMENT=true

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672 